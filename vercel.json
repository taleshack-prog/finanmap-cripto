{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "regions": ["gru1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@finanmap_backend_url",
    "NEXT_PUBLIC_GA_URL": "@finanmap_ga_url"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://finanmap-backend.up.railway.app/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
